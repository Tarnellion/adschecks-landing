---
import '../styles/index.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  ogTitle,
  ogDescription,
  bodyClass,
} = Astro.props;

const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDesc = ogDescription ?? description;
const currentPath = new URL(canonical).pathname;
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0e13" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/favicons/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AdsChecks" />
    <meta name="twitter:image:alt" content="AdsChecks — Ad Slot Verification Tool" />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://adschecks.com/og.png?v=20260317" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDesc} />
    <meta name="twitter:image" content="https://adschecks.com/og.png?v=20260317" />
    <link rel="preconnect" href="https://app.adschecks.com" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="read-progress" aria-hidden="true"></div>
    <header class="header">
      <div class="container header__inner">
        <a class="brand" href="/">AdsChecks</a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
        >
          <span class="sr-only">Toggle navigation</span>
          <span class="nav-toggle__line"></span>
          <span class="nav-toggle__line"></span>
          <span class="nav-toggle__line"></span>
        </button>
        <nav id="primary-nav" class="nav" aria-label="Primary">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
          <a href="/pricing/" aria-current={currentPath.startsWith('/pricing') ? 'page' : undefined}>Pricing</a>
          <a href="/blog/" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a href="/faq/" aria-current={currentPath.startsWith('/faq') ? 'page' : undefined}>FAQ</a>
          <a href="/what-we-verify/" aria-current={currentPath.startsWith('/what-we-verify') ? 'page' : undefined}>What we verify</a>
          <a href="/status-model/" aria-current={currentPath.startsWith('/status-model') ? 'page' : undefined}>Status model</a>
          <a href="/about/" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About</a>
          <span class="nav-divider" aria-hidden="true"></span>
          <a href="https://app.adschecks.com/signin" class="nav__login">Log in</a>
          <a href="https://app.adschecks.com/signup?plan=starter" class="nav__cta">Get started</a>
        </nav>
      </div>
    </header>
    <div class="nav-overlay" aria-hidden="true"></div>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__grid">
        <div class="footer__brand">
          <a class="footer__brand-link" href="/">AdsChecks</a>
          <p class="muted">Ad slot verification with screenshot proof — across any GEO and device. For affiliate managers, media buyers, and publishers.</p>
        </div>
        <div class="footer__group">
          <div class="footer__title">Product</div>
          <div class="footer__links">
            <a href="/pricing/">Pricing</a>
            <a href="/what-we-verify/">What we verify</a>
            <a href="/status-model/">Status model</a>
            <a href="/ad-slot-verification/">Ad slot verification</a>
            <a href="/blog/">Blog</a>
            <a href="/about/">About</a>
            <a href="/faq/">FAQ</a>
            <a href="https://app.adschecks.com/signup?plan=starter">Get started</a>
          </div>
        </div>
        <div class="footer__group">
          <div class="footer__title">Policies</div>
          <div class="footer__links">
            <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
            <a href="/refund-policy/">Refund Policy</a>
            <a href="/privacy-policy/">Privacy Policy</a>
            <a href="/legal-notice/">Legal Notice</a>
            {gaId && <button id="cookie-settings" class="footer__link-btn" type="button">Cookie settings</button>}
          </div>
        </div>
      </div>
    </footer>

    <script src="/script.js" defer></script>

    {gaId && (
      <>
        <div id="cookie-bar" class="cookie-bar" role="region" aria-label="Cookie consent" hidden>
          <p class="cookie-bar__text">
            We use strictly necessary cookies to run this site. May we also use analytics cookies to
            see which pages are useful? <a href="/privacy-policy/">Privacy Policy</a>
          </p>
          <div class="cookie-bar__actions">
            <button id="cookie-decline" class="cookie-bar__btn cookie-bar__btn--ghost" type="button">Decline</button>
            <button id="cookie-accept" class="cookie-bar__btn" type="button">Accept</button>
          </div>
        </div>
        <script is:inline define:vars={{ gaId }}>
          (function () {
            var KEY = 'consent-analytics';

            function loadAnalytics() {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { window.dataLayer.push(arguments); };
              window.gtag('js', new Date());
              window.gtag('config', gaId);
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
              document.head.appendChild(s);
            }

            var bar = document.getElementById('cookie-bar');
            if (!bar) return;

            var stored = null;
            try { stored = localStorage.getItem(KEY); } catch (e) {}

            var remember = function (value) {
              var saved = false;
              try { localStorage.setItem(KEY, value); saved = true; } catch (e) {}
              // Если сохранить не удалось (приватный режим), не прячем баннер молча —
              // иначе посетитель увидит подтверждение выбора, которого нет.
              if (saved) bar.setAttribute('hidden', '');
              return saved;
            };

            document.getElementById('cookie-accept').addEventListener('click', function () {
              remember('granted');
              loadAnalytics();
            });
            document.getElementById('cookie-decline').addEventListener('click', function () {
              remember('denied');
            });

            var settings = document.getElementById('cookie-settings');
            if (settings) {
              settings.addEventListener('click', function () {
                try { localStorage.removeItem(KEY); } catch (e) {}
                bar.removeAttribute('hidden');
                bar.scrollIntoView({ block: 'nearest' });
                document.getElementById('cookie-decline').focus();
              });
            }

            if (stored === 'granted') { loadAnalytics(); return; }
            if (stored === 'denied') return;

            bar.removeAttribute('hidden');
          })();
        </script>
      </>
    )}
  </body>
</html>
