---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="Ad Slot Verification Blog — AdsChecks"
  description="Practical guides on ad slot QA, verification workflows, Prebid.js delivery, and evidence-based dispute resolution."
  canonical="https://adschecks.com/blog/"
  bodyClass="page-blog"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "AdsChecks Blog",
      "description": "Practical guides on ad slot QA, verification workflows, and evidence-based dispute resolution.",
      "url": "https://adschecks.com/blog/",
      "publisher": {
        "@type": "Organization",
        "name": "AdsChecks",
        "url": "https://adschecks.com",
        "logo": "https://adschecks.com/assets/favicons/favicon-512.png"
      }
    })}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://adschecks.com/", "name": "AdsChecks" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": "https://adschecks.com/blog/", "name": "Blog" } }
      ]
    })}></script>
  </Fragment>

  <section class="section">
    <div class="container legal-page legal-page--wide">
      <div class="doc-hero">
        <div class="doc-hero__copy">
          <p class="section__eyebrow mono">Guides &amp; explainers</p>
          <h1>Ad Slot Verification Blog</h1>
          <p class="lead">Practical guides on QA workflows, Prebid delivery, GEO-specific verification, and evidence-based dispute resolution.</p>
        </div>
        <div class="doc-hero__meta">
          <div class="doc-meta__item">
            <div class="doc-meta__k">Topics</div>
            <div class="doc-meta__v">QA checklists, Prebid.js, fraud vs verification, GEO delivery</div>
          </div>
          <div class="doc-meta__item">
            <div class="doc-meta__k">Audience</div>
            <div class="doc-meta__v">Ad-ops, media buyers, publishers, affiliate managers</div>
          </div>
        </div>
      </div>

      <div class="blog-list">
        {posts.map((post) => (
          <article class="blog-card">
            <div class="blog-card__meta">
              <time class="blog-card__date mono" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {post.data.tags.slice(0, 2).map(tag => (
                <span class="blog-card__tag mono">{tag}</span>
              ))}
            </div>
            <h2 class="blog-card__title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="blog-card__desc">{post.data.description}</p>
            <a class="blog-card__link" href={`/blog/${post.id}/`}>Read article →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <div class="section__copy">
          <h2>Ready to verify your ad slots?</h2>
          <p class="section__intro">Start a 3-day free trial — no charge until day 4.</p>
        </div>
      </div>
      <div class="cta">
        <div class="cta__copy">
          <div class="cta__actions">
            <a href="https://app.adschecks.com/signup?plan=starter" class="btn">Start free trial</a>
            <a href="/pricing/" class="btn btn--ghost">See pricing</a>
          </div>
          <p class="fine">3-day free trial &middot; Cancel any time</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
