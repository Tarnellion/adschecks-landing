---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="AdsChecks Legal Notice | Operator and Contact Information"
  description="View the AdsChecks legal notice with operator details and public contact information."
  canonical="https://adschecks.com/legal-notice/"
  bodyClass="page-legal-notice"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "AdsChecks",
      "url": "https://adschecks.com",
      "email": "contact@adschecks.com",
      "description": "Ad slot verification with proof-first reporting.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Zakrevskoho Street 57",
        "addressLocality": "Kyiv",
        "postalCode": "02232",
        "addressCountry": "UA"
      }
    })}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://adschecks.com/", "name": "AdsChecks" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": "https://adschecks.com/legal-notice/", "name": "Legal Notice" } }
      ]
    })}></script>
  </Fragment>

  <section class="section">
    <div class="container legal-page">
      <div class="doc-hero">
        <div class="doc-hero__copy">
          <p class="section__eyebrow mono">Operator notice</p>
          <h1>Legal Notice</h1>
          <p class="lead">Operator and public contact information for AdsChecks.</p>
        </div>
        <div class="doc-hero__meta">
          <div class="doc-meta__item">
            <div class="doc-meta__k">Operator</div>
            <div class="doc-meta__v">Taras Hovorukha</div>
          </div>
          <div class="doc-meta__item">
            <div class="doc-meta__k">Address</div>
            <div class="doc-meta__v">Zakrevskoho Street 57, Kyiv 02232, Ukraine</div>
          </div>
          <div class="doc-meta__item">
            <div class="doc-meta__k">Contact</div>
            <div class="doc-meta__v"><a href="mailto:contact@adschecks.com">contact@adschecks.com</a></div>
          </div>
        </div>
      </div>

      <div class="doc-card">
        <h2>Project information</h2>
        <p>AdsChecks</p>
        <p>Operated by Taras Hovorukha</p>
        <p>Zakrevskoho Street 57</p>
        <p>Kyiv 02232, Ukraine</p>
      </div>

      <div class="doc-card">
        <h2>Contact</h2>
        <p><a href="mailto:contact@adschecks.com">contact@adschecks.com</a></p>
      </div>

      <div class="doc-card">
        <h2>Responsible for content</h2>
        <p>Taras Hovorukha</p>
      </div>

      <div class="doc-card">
        <h2>Service terms references</h2>
        <p>
          Scope of verification, status interpretation, pricing usage rules, and refund/dispute rules are published here:
        </p>
        <ul>
          <li><a href="/what-we-verify/">What we verify</a></li>
          <li><a href="/status-model/">Status model</a></li>
          <li><a href="/pricing/">Pricing</a></li>
          <li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li>
          <li><a href="/refund-policy/">Refund Policy</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
