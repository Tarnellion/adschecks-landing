---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ad Slot Verification FAQ — AdsChecks"
  description="What counts as a verified page? How does GEO routing work? What does SLOT_EMPTY mean? Find answers to every AdsChecks question here."
  canonical="https://adschecks.com/faq/"
  ogTitle="Ad Slot Verification FAQ — AdsChecks"
  bodyClass="page-faq"
>
  <Fragment slot="head">
        <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What counts as a verified page?", "acceptedAnswer": { "@type": "Answer", "text": "One completed page load for a target URL in a selected check context (GEO + device), with verification of up to 5 predefined ad slots. Each verified page produces statuses, screenshots, JSON metadata, and a UTC timestamp." } },
        { "@type": "Question", "name": "What happens if my page has more than 5 ad slots?", "acceptedAnswer": { "@type": "Answer", "text": "Each verified page checks up to 5 predefined selectors. If you need to verify more slots, you can run multiple checks with different selector sets for the same URL." } },
        { "@type": "Question", "name": "What does CHALLENGE_DETECTED or BLOCKED mean?", "acceptedAnswer": { "@type": "Answer", "text": "These are valid verification outcomes, not errors. CHALLENGE_DETECTED means an anti-bot challenge or interstitial was encountered. BLOCKED means access was prevented in that environment. Both are billable because the page load was completed and evidence was captured." } },
        { "@type": "Question", "name": "How do I get started?", "acceptedAnswer": { "@type": "Answer", "text": "Sign up at app.adschecks.com/signup, pick a plan, and complete checkout via Paddle. Your account is provisioned immediately after payment — no approval step and no waiting period." } },
        { "@type": "Question", "name": "When does billing start?", "acceptedAnswer": { "@type": "Answer", "text": "Billing starts when you complete checkout. Your full monthly capacity is available immediately — there is no approval step and no waiting period." } },
        { "@type": "Question", "name": "How fast do I get results?", "acceptedAnswer": { "@type": "Answer", "text": "Most verification runs complete within seconds to a few minutes depending on GEO routing and page complexity. Results are available in the dashboard immediately after completion." } },
        { "@type": "Question", "name": "Can I use AdsChecks to check competitor pages?", "acceptedAnswer": { "@type": "Answer", "text": "You may only verify pages and environments you are authorized to test. See the Acceptable Use section in our Terms & Conditions." } },
        { "@type": "Question", "name": "What browsers and devices do you support?", "acceptedAnswer": { "@type": "Answer", "text": "Checks run in Chromium-based environments with desktop and mobile viewport emulation. The specific device context is attached to every result for comparison." } },
        { "@type": "Question", "name": "How do refunds work?", "acceptedAnswer": { "@type": "Answer", "text": "Completed verified pages are not refundable, including results with CHALLENGE_DETECTED and BLOCKED statuses. Duplicate or clearly accidental charges can be reviewed. See our Refund Policy for full details." } },
        { "@type": "Question", "name": "Can I verify ad slots on pages I don't own as a publisher?", "acceptedAnswer": { "@type": "Answer", "text": "Publishers can use AdsChecks to verify ad delivery on their own properties — checking that slots are rendering as configured, that sponsored placements are appearing correctly, and that GEO-specific delivery is working. You may only check pages and environments you control or are authorized to test." } },
        { "@type": "Question", "name": "Can I manage multiple clients or sites under one account?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. You can run checks across multiple domains and sites within a single account. Each check is scoped to a specific URL and context — this makes AdsChecks suitable for agencies managing verification across several publisher or advertiser accounts. For higher-volume multi-client usage, contact us about a Custom plan." } }
      ]
    })}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "AdsChecks",
      "url": "https://adschecks.com",
      "email": "contact@adschecks.com",
      "description": "Ad slot verification with proof-first reporting.",
      "logo": "https://adschecks.com/assets/favicons/favicon-512.png",
      "address": { "@type": "PostalAddress", "addressCountry": "UA" },
      "contactPoint": { "@type": "ContactPoint", "email": "contact@adschecks.com", "contactType": "customer support" }
    })}></script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://adschecks.com/", "name": "AdsChecks" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": "https://adschecks.com/faq/", "name": "FAQ" } }
      ]
    })}></script>
  </Fragment>

  <section class="section">
    <div class="container legal-page legal-page--wide">
      <div class="doc-hero">
        <div class="doc-hero__copy">
          <p class="section__eyebrow mono">Common questions</p>
          <h1>Ad Slot Verification — Frequently Asked Questions</h1>
          <p class="lead">Answers to the most common questions about verification scope, billing, and setup.</p>
        </div>
        <div class="doc-hero__meta">
          <div class="doc-meta__item">
            <div class="doc-meta__k">Scope</div>
            <div class="doc-meta__v">Verified pages, slot limits, GEO and device context.</div>
          </div>
          <div class="doc-meta__item">
            <div class="doc-meta__k">Billing</div>
            <div class="doc-meta__v">Plan tiers, billable outcomes, and access model.</div>
          </div>
          <div class="doc-meta__item">
            <div class="doc-meta__k">Support</div>
            <div class="doc-meta__v">Setup expectations, speed, acceptable use, refund path.</div>
          </div>
        </div>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>What counts as a verified page?</summary>
          <p>
            One completed page load for a target URL in a selected check context (GEO + device), with
            verification of up to 5 predefined ad slots. Each verified page produces statuses, screenshots,
            JSON metadata, and a UTC timestamp.
          </p>
        </details>
        <details class="faq-item">
          <summary>What happens if my page has more than 5 ad slots?</summary>
          <p>
            Each verified page checks up to 5 predefined selectors. If you need to verify more slots, you can
            run multiple checks with different selector sets for the same URL.
          </p>
        </details>
        <details class="faq-item">
          <summary>What does CHALLENGE_DETECTED or BLOCKED mean?</summary>
          <p>
            These are valid verification outcomes, not errors. CHALLENGE_DETECTED means an anti-bot challenge
            or interstitial was encountered. BLOCKED means access was prevented in that environment. Both are
            billable because the page load was completed and evidence was captured.
          </p>
        </details>
        <details class="faq-item">
          <summary>How do I get started?</summary>
          <p>
            Sign up at <a href="https://app.adschecks.com/signup">app.adschecks.com/signup</a>, pick a plan, and
            complete checkout via Paddle. Your account is provisioned immediately after payment — no approval step
            and no waiting period.
          </p>
        </details>
        <details class="faq-item">
          <summary>When does billing start?</summary>
          <p>Billing starts when you complete checkout. Your full monthly capacity is available immediately — there is no approval step and no waiting period.</p>
        </details>
        <details class="faq-item">
          <summary>How fast do I get results?</summary>
          <p>
            Most verification runs complete within seconds to a few minutes depending on GEO routing and page
            complexity. Results are available in the dashboard immediately after completion.
          </p>
        </details>
        <details class="faq-item">
          <summary>Can I use AdsChecks to check competitor pages?</summary>
          <p>
            You may only verify pages and environments you are authorized to test. See the Acceptable Use
            section in our Terms &amp; Conditions.
          </p>
        </details>
        <details class="faq-item">
          <summary>What browsers and devices do you support?</summary>
          <p>
            Checks run in Chromium-based environments with desktop and mobile viewport emulation. The specific
            device context is attached to every result for comparison.
          </p>
        </details>
        <details class="faq-item">
          <summary>How do refunds work?</summary>
          <p>
            Completed verified pages are not refundable, including results with CHALLENGE_DETECTED and BLOCKED
            statuses. Duplicate or clearly accidental charges can be reviewed. See our Refund Policy for full
            details.
          </p>
        </details>
        <details class="faq-item">
          <summary>Can I verify ad slots on pages I don't own as a publisher?</summary>
          <p>
            Publishers can use AdsChecks to verify ad delivery on their own properties — checking that slots are
            rendering as configured, that sponsored placements are appearing correctly, and that GEO-specific
            delivery is working. You may only check pages and environments you control or are authorized to test.
          </p>
        </details>
        <details class="faq-item">
          <summary>Can I manage multiple clients or sites under one account?</summary>
          <p>
            Yes. You can run checks across multiple domains and sites within a single account. Each check is
            scoped to a specific URL and context — this makes AdsChecks suitable for agencies managing
            verification across several publisher or advertiser accounts. For higher-volume multi-client usage,
            <a href="mailto:contact@adschecks.com">contact us</a> about a Custom plan.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <div class="section__copy">
          <h2>Ready to start verifying?</h2>
          <p class="section__intro">Pick a plan and start verifying — self-serve checkout, no sales call.</p>
        </div>
      </div>
      <div class="cta">
        <div class="cta__copy">
          <div class="cta__actions">
            <a href="https://app.adschecks.com/signup?plan=starter" class="btn">Get started</a>
            <a href="/pricing/" class="btn btn--ghost">See pricing</a>
          </div>
          <p class="fine">Public pricing &middot; Cancel any time</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
