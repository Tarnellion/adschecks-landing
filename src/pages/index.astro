---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ad Slot Verification Tool — AdsChecks"
  description="Stop trusting reports. Verify your ad slots with screenshot proof across 12+ GEOs and devices. 3-day free trial — no charge until day 4."
  canonical="https://adschecks.com/"
>
  <Fragment slot="head">
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "AdsChecks",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Ad slot verification with proof-first reporting for repeatable QA, commercial review, and dispute support.",
      "url": "https://adschecks.com",
      "author": { "@type": "Person", "name": "Taras Hovorukha", "url": "https://adschecks.com/about/" },
      "offers": [
        { "@type": "Offer", "name": "Starter", "price": "39", "priceCurrency": "USD", "priceSpecification": { "@type": "UnitPriceSpecification", "price": "39", "priceCurrency": "USD", "billingIncrement": 1, "unitCode": "MON" } },
        { "@type": "Offer", "name": "Growth", "price": "79", "priceCurrency": "USD", "priceSpecification": { "@type": "UnitPriceSpecification", "price": "79", "priceCurrency": "USD", "billingIncrement": 1, "unitCode": "MON" } },
        { "@type": "Offer", "name": "Standard", "price": "149", "priceCurrency": "USD", "priceSpecification": { "@type": "UnitPriceSpecification", "price": "149", "priceCurrency": "USD", "billingIncrement": 1, "unitCode": "MON" } }
      ]
    })}</script>
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "AdsChecks",
      "url": "https://adschecks.com",
      "email": "contact@adschecks.com",
      "description": "Ad slot verification with proof-first reporting.",
      "logo": "https://adschecks.com/assets/favicons/favicon-512.png",
      "address": { "@type": "PostalAddress", "addressCountry": "UA" },
      "contactPoint": { "@type": "ContactPoint", "email": "contact@adschecks.com", "contactType": "customer support" }
    })}</script>
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "AdsChecks",
      "url": "https://adschecks.com/"
    })}</script>
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What counts as a verified page?", "acceptedAnswer": { "@type": "Answer", "text": "One completed page load for a target URL in a selected check context (GEO + device), with verification of up to 5 predefined ad slots. Each verified page produces statuses, screenshots, JSON metadata, and a UTC timestamp." } },
        { "@type": "Question", "name": "What happens if my page has more than 5 ad slots?", "acceptedAnswer": { "@type": "Answer", "text": "Each verified page checks up to 5 predefined selectors. If you need to verify more slots, you can run multiple checks with different selector sets for the same URL." } },
        { "@type": "Question", "name": "What does CHALLENGE_DETECTED or BLOCKED mean?", "acceptedAnswer": { "@type": "Answer", "text": "These are valid verification outcomes, not errors. CHALLENGE_DETECTED means an anti-bot challenge or interstitial was encountered. BLOCKED means access was prevented in that environment. Both are billable because the page load was completed and evidence was captured." } },
        { "@type": "Question", "name": "When does billing start?", "acceptedAnswer": { "@type": "Answer", "text": "All plans include a 3-day free trial. Billing starts on day 4 after you complete checkout. Your monthly capacity is available immediately — no approval step required." } },
        { "@type": "Question", "name": "How fast do I get results?", "acceptedAnswer": { "@type": "Answer", "text": "Most verification runs complete within seconds to a few minutes depending on GEO routing and page complexity. Results are available in the dashboard immediately after completion." } },
        { "@type": "Question", "name": "What browsers and devices do you support?", "acceptedAnswer": { "@type": "Answer", "text": "Checks run in Chromium-based environments with desktop and mobile viewport emulation. The specific device context is attached to every result for comparison." } },
        { "@type": "Question", "name": "Can I manage multiple clients or sites under one account?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. You can run checks across multiple domains and sites within a single account. Each check is scoped to a specific URL and context — this makes AdsChecks suitable for agencies managing verification across several publisher or advertiser accounts." } }
      ]
    })}</script>
  </Fragment>

  <section id="hero" class="hero" data-scene-bg="#0a0e13" data-scene-accent="#6eb8ff">
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--signal">For affiliate managers, media buyers &amp; publishers</p>
        <h1>Verify your ad slots with <span class="u-grad-text">screenshot proof</span> — across any GEO and device.</h1>
        <p class="lead">
          Know exactly what runs on your pages — verified with screenshots, status codes, and JSON
          metadata captured in real <span class="pill pill--ink">GEO</span> and
          <span class="pill pill--ink">device</span> context. Up to 5 slots per page load.
        </p>
        <div class="hero__actions">
          <a class="btn" href="https://app.adschecks.com/signup?plan=starter">Start free trial</a>
          <a class="btn btn--ghost" href="#how-it-works">How it works</a>
        </div>
        <p class="fine">3-day free trial &middot; No charge until day 4 &middot; Cancel any time</p>
      </div>

      <div class="hero__status-card" aria-hidden="true">
        <div class="hero__status-card-head">
          <span class="hero__status-card-url mono">adschecks.com/lp/brand-deal</span>
          <span class="hero__status-badge">verified</span>
        </div>
        <div class="hero__status-card-rows">
          <div class="hero__status-row">
            <span class="hero__status-slot mono">SLOT 01 · 970×250</span>
            <span class="hero__status-ok">OK</span>
          </div>
          <div class="hero__status-row">
            <span class="hero__status-slot mono">SLOT 02 · 300×250</span>
            <span class="hero__status-ok">OK</span>
          </div>
          <div class="hero__status-row">
            <span class="hero__status-slot mono">SLOT 03 · 728×90</span>
            <span class="hero__status-empty">SLOT_EMPTY</span>
          </div>
        </div>
        <div class="hero__status-card-meta mono">London, GB &middot; Desktop &middot; 14:22 UTC</div>
      </div>


<div class="hero__viz map-viz" aria-label="Global verification map">
        <div class="map-viz__inner">
          <div class="map-viz__map" aria-hidden="true"></div>
          <span class="sr-only">World map for geo verification coverage</span>
          <div class="map-viz__line line-1" aria-hidden="true"></div>
          <div class="map-viz__line line-2" aria-hidden="true"></div>
          <div class="map-viz__line line-3" aria-hidden="true"></div>
          <div class="map-viz__line line-4" aria-hidden="true"></div>
          <div class="map-viz__location loc-ny is-track" aria-hidden="true"><span class="map-viz__point"></span><span class="map-viz__city">New York</span></div>
          <div class="map-viz__location loc-lon is-track" aria-hidden="true"><span class="map-viz__point"></span><span class="map-viz__city">London</span></div>
          <div class="map-viz__location loc-sgp is-track" aria-hidden="true"><span class="map-viz__point"></span><span class="map-viz__city">Singapore</span></div>
          <div class="map-viz__location loc-tok is-track" aria-hidden="true"><span class="map-viz__point"></span><span class="map-viz__city">Tokyo</span></div>
          <div class="map-viz__location loc-syd" aria-hidden="true"><span class="map-viz__point"></span><span class="map-viz__city">Sydney</span></div>
          <div class="map-viz__pointer ptr-1" data-from="loc-lon" data-to="b1" data-corner="bl" aria-hidden="true"><span class="map-viz__pointer-dot"></span><span class="map-viz__pointer-beam"></span></div>
          <div class="map-viz__pointer ptr-2" data-from="loc-tok" data-to="b2" data-corner="tr" aria-hidden="true"><span class="map-viz__pointer-dot"></span><span class="map-viz__pointer-beam"></span></div>
          <div class="map-viz__pointer ptr-3" data-from="loc-ny" data-to="b3" data-corner="tl" aria-hidden="true"><span class="map-viz__pointer-dot"></span><span class="map-viz__pointer-beam"></span></div>
          <div class="map-viz__pointer ptr-4" data-from="loc-sgp" data-to="b4" data-corner="tl" aria-hidden="true"><span class="map-viz__pointer-dot"></span><span class="map-viz__pointer-beam"></span></div>
          <div class="map-viz__browser b1" aria-hidden="true">
            <div class="map-viz__browser-head"><span></span><span></span><span></span><span class="map-viz__browser-mode map-viz__browser-mode--desktop">Desktop</span></div>
            <div class="map-viz__browser-body"><div class="map-viz__browser-row w90"></div><div class="map-viz__browser-row w72"></div><div class="map-viz__scanline"></div><div class="map-viz__slot slot-main"><span>SLOT 01 · 970×250</span></div></div>
          </div>
          <div class="map-viz__browser map-viz__browser--mobile b2" aria-hidden="true">
            <div class="map-viz__browser-head"><span></span><span></span><span></span><span class="map-viz__browser-mode map-viz__browser-mode--mobile">Mobile</span></div>
            <div class="map-viz__browser-body"><div class="map-viz__browser-row w86"></div><div class="map-viz__browser-row w64"></div><div class="map-viz__scanline"></div><div class="map-viz__slot slot-mobile-top"><span>SLOT · 300×250</span></div><div class="map-viz__slot slot-mobile-bottom"><span>SLOT · 320×100</span></div></div>
          </div>
          <div class="map-viz__browser b3" aria-hidden="true">
            <div class="map-viz__browser-head"><span></span><span></span><span></span><span class="map-viz__browser-mode map-viz__browser-mode--desktop">Desktop</span></div>
            <div class="map-viz__browser-body"><div class="map-viz__browser-row w88"></div><div class="map-viz__browser-row w70"></div><div class="map-viz__scanline"></div><div class="map-viz__slot slot-square"><span>336×280</span></div></div>
          </div>
          <div class="map-viz__browser map-viz__browser--mobile b4" aria-hidden="true">
            <div class="map-viz__browser-head"><span></span><span></span><span></span><span class="map-viz__browser-mode map-viz__browser-mode--mobile">Mobile</span></div>
            <div class="map-viz__browser-body"><div class="map-viz__browser-row w90"></div><div class="map-viz__browser-row w76"></div><div class="map-viz__scanline"></div><div class="map-viz__slot slot-mobile-top"><span>SLOT · 300×250</span></div><div class="map-viz__slot slot-mobile-bottom"><span>SLOT · 320×100</span></div></div>
          </div>
          <div class="map-viz__ambient-scan" aria-hidden="true"></div>
          <div class="map-viz__noise" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats-bar" aria-label="Platform statistics">
    <div class="stats-bar__inner">
      <div class="stats-bar__item">
        <span class="stats-bar__num">12+</span>
        <span class="stats-bar__label">GEO regions</span>
      </div>
      <div class="stats-bar__sep" aria-hidden="true"></div>
      <div class="stats-bar__item">
        <span class="stats-bar__num">5</span>
        <span class="stats-bar__label">slots per check</span>
      </div>
      <div class="stats-bar__sep" aria-hidden="true"></div>
      <div class="stats-bar__item">
        <span class="stats-bar__num">&lt;2 min</span>
        <span class="stats-bar__label">average run time</span>
      </div>
      <div class="stats-bar__sep" aria-hidden="true"></div>
      <div class="stats-bar__item">
        <span class="stats-bar__num">JSON + PNG</span>
        <span class="stats-bar__label">evidence bundle</span>
      </div>
    </div>
  </section>

  <section id="problem" class="section section--alt" data-scene-bg="#080c0f" data-scene-accent="#ff7a90">
    <div class="container">
      <div class="section__head reveal">
        <div class="section__copy">
          <p class="section__eyebrow mono">Why proof matters</p>
          <h2>Why ad slot QA fails without proof</h2>
          <p class="section__intro">Verification breaks down when geo, device, and slot state shift faster than a team can document them.</p>
        </div>
      </div>
      <div class="prob-list reveal-group">
        <div class="prob-item reveal">
          <div class="prob-item__num" aria-hidden="true">01</div>
          <div class="prob-item__body">
            <div class="prob-item__tag">Coverage</div>
            <h3>Geo uncertainty</h3>
            <p>Ad slots render differently across countries, devices, and sessions. What passes QA in one region fails silently in another.</p>
          </div>
        </div>
        <div class="prob-item reveal">
          <div class="prob-item__num" aria-hidden="true">02</div>
          <div class="prob-item__body">
            <div class="prob-item__tag">Trust</div>
            <h3>Disputes without evidence</h3>
            <p>Without consistent proof, QA findings are hard to share, compare, or escalate. Screenshots and metadata reduce ambiguity.</p>
          </div>
        </div>
        <div class="prob-item reveal">
          <div class="prob-item__num" aria-hidden="true">03</div>
          <div class="prob-item__body">
            <div class="prob-item__tag">Time</div>
            <h3>Operational drag</h3>
            <p>Manual checks take time and still leave gaps in coverage and repeatability. Templates and structured runs remove repeated setup work.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="what-we-check" class="section section--alt" data-scene-bg="#0d1020" data-scene-accent="#a78bfa">
    <div class="container">
      <div class="section__head reveal">
        <div class="section__copy">
          <p class="section__eyebrow mono">Evidence scope</p>
          <h2>What we check</h2>
          <p class="section__intro">Each verified page is constrained on purpose: one completed page load, selected context, and up to five predefined slots.</p>
        </div>
      </div>
      <div class="check-grid reveal-group">
        <div class="check-item reveal">
          <div class="check-item__num" aria-hidden="true">01</div>
          <div class="check-item__body">
            <div class="check-item__layer">Verification layer</div>
            <h3>Slot presence and visibility</h3>
            <ul class="check-item__list">
              <li>Slot detected on page</li>
              <li>Position and layout context</li>
              <li>Visibility state — visible, partial, or missing</li>
            </ul>
            <p class="check-item__note">Predefined selectors, not discovery scanning.</p>
          </div>
        </div>
        <div class="check-item reveal">
          <div class="check-item__num" aria-hidden="true">02</div>
          <div class="check-item__body">
            <div class="check-item__layer">Context layer</div>
            <h3>Geo and device coverage</h3>
            <ul class="check-item__list">
              <li>Region-specific render checks</li>
              <li>Desktop and mobile snapshots</li>
              <li>Viewport and breakpoint metadata</li>
            </ul>
            <p class="check-item__note">Runs stay tied to the selected context for comparison.</p>
          </div>
        </div>
        <div class="check-item reveal">
          <div class="check-item__num" aria-hidden="true">03</div>
          <div class="check-item__body">
            <div class="check-item__layer">Artifact layer</div>
            <h3>Evidence bundle</h3>
            <ul class="check-item__list">
              <li>Screenshots for each slot</li>
              <li>JSON metadata and timestamps</li>
              <li>Export-ready ZIP bundle</li>
            </ul>
            <p class="check-item__note">Consistent outputs across all runs, reviews, and disputes.</p>
          </div>
        </div>
        <div class="check-item reveal">
          <div class="check-item__num" aria-hidden="true">04</div>
          <div class="check-item__body">
            <div class="check-item__layer">Ops layer</div>
            <h3>Operational integrity</h3>
            <ul class="check-item__list">
              <li>Repeatable checks from templates</li>
              <li>Clear issue flags and statuses</li>
              <li>Structured results for export</li>
            </ul>
            <p class="check-item__note">Built for repeatability, not one-off screenshots.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section" data-scene-bg="#0b1220" data-scene-accent="#ffc36a">
    <div class="container">
      <div class="section__head reveal">
        <div class="section__copy">
          <p class="section__eyebrow mono">Template → Run → Evidence</p>
          <h2>How it works</h2>
          <p class="section__intro">The workflow stays compact: define the check context once, run it manually or on schedule, then review a structured evidence package.</p>
        </div>
      </div>
      <div class="timeline reveal-group">
        <div class="timeline__step reveal">
          <div class="timeline__circle" aria-hidden="true"><span>01</span></div>
          <div class="timeline__body">
            <div class="timeline__label mono">Template</div>
            <h3>Define the check context</h3>
            <p class="fine">Provide URLs, slot selectors, device, GEO, and optional proxy routing settings.</p>
            <div class="timeline__tags">
              <span class="timeline__tag mono">URLs · List</span>
              <span class="timeline__tag mono">Slots · Up to 5</span>
              <span class="timeline__tag mono">GEO · ISO codes</span>
            </div>
          </div>
        </div>
        <div class="timeline__step reveal">
          <div class="timeline__circle" aria-hidden="true"><span>02</span></div>
          <div class="timeline__body">
            <div class="timeline__label mono">Run</div>
            <h3>Execute manual or scheduled</h3>
            <p class="fine">Run a manual check or schedule it. Each page load becomes one verified page.</p>
            <div class="timeline__tags">
              <span class="timeline__tag mono">Mode · Manual / Scheduled</span>
              <span class="timeline__tag mono">Device · Desktop / Mobile</span>
              <span class="timeline__tag mono">Proxy · Optional</span>
            </div>
          </div>
        </div>
        <div class="timeline__step reveal">
          <div class="timeline__circle" aria-hidden="true"><span>03</span></div>
          <div class="timeline__body">
            <div class="timeline__label mono">Evidence</div>
            <h3>Review the evidence bundle</h3>
            <p class="fine">Output includes slot statuses, screenshots, JSON metadata, and a timestamped evidence bundle.</p>
            <div class="timeline__tags">
              <span class="timeline__tag mono">Artifacts · Screens + JSON</span>
              <span class="timeline__tag mono">Timestamp · Included</span>
              <span class="timeline__tag mono">Structure · Consistent</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="sample-output" class="section section--alt" data-scene-bg="#0b1018" data-scene-accent="#6eb8ff">
    <div class="container">
      <div class="section__head reveal">
        <div class="section__copy">
          <p class="section__eyebrow mono">Evidence bundle</p>
          <h2>Structured proof on every run</h2>
          <p class="section__intro">Every run produces a consistent output — slot statuses, full-page screenshot, JSON metadata, and a UTC timestamp — regardless of what you find.</p>
        </div>
      </div>
      <div class="sample-output reveal">
        <div class="sample-output__json">
          <div class="sample-output__bar">
            <span class="sample-output__dot sample-output__dot--red"></span>
            <span class="sample-output__dot sample-output__dot--yellow"></span>
            <span class="sample-output__dot sample-output__dot--green"></span>
            <span class="sample-output__filename mono">result.json</span>
          </div>
          <pre class="sample-output__code"><code>&#123;
  <span class="tok-key">"check_id"</span>: <span class="tok-str">"chk_8f3k2x"</span>,
  <span class="tok-key">"url"</span>: <span class="tok-str">"https://publisher.example/article"</span>,
  <span class="tok-key">"geo"</span>: <span class="tok-str">"US"</span>,
  <span class="tok-key">"device"</span>: <span class="tok-str">"desktop"</span>,
  <span class="tok-key">"timestamp"</span>: <span class="tok-str">"2026-03-15T09:22:41Z"</span>,
  <span class="tok-key">"slots"</span>: [
    &#123;
      <span class="tok-key">"selector"</span>: <span class="tok-str">"#div-gpt-ad-header-0"</span>,
      <span class="tok-key">"status"</span>: <span class="tok-ok">"OK"</span>,
      <span class="tok-key">"dimensions"</span>: <span class="tok-str">"970x250"</span>
    &#125;,
    &#123;
      <span class="tok-key">"selector"</span>: <span class="tok-str">"#sidebar-ad-300x250"</span>,
      <span class="tok-key">"status"</span>: <span class="tok-ok">"OK"</span>,
      <span class="tok-key">"dimensions"</span>: <span class="tok-str">"300x250"</span>
    &#125;,
    &#123;
      <span class="tok-key">"selector"</span>: <span class="tok-str">"#sticky-footer-ad"</span>,
      <span class="tok-key">"status"</span>: <span class="tok-empty">"SLOT_EMPTY"</span>,
      <span class="tok-key">"dimensions"</span>: <span class="tok-str">"728x90"</span>
    &#125;
  ],
  <span class="tok-key">"evidence"</span>: &#123;
    <span class="tok-key">"screenshot"</span>: <span class="tok-str">"chk_8f3k2x/full.png"</span>,
    <span class="tok-key">"zip"</span>: <span class="tok-str">"chk_8f3k2x/bundle.zip"</span>
  &#125;
&#125;</code></pre>
        </div>
        <div class="sample-output__preview">
          <div class="sample-output__bar">
            <span class="sample-output__dot sample-output__dot--red"></span>
            <span class="sample-output__dot sample-output__dot--yellow"></span>
            <span class="sample-output__dot sample-output__dot--green"></span>
            <span class="sample-output__filename mono">full.png &middot; US &middot; Desktop</span>
          </div>
          <div class="sample-output__screen" aria-hidden="true">
            <div class="sample-output__nav-bar"></div>
            <div class="sample-output__slot sample-output__slot--ok">
              <span class="sample-output__slot-label">970×250 · OK</span>
            </div>
            <div class="sample-output__body-lines">
              <div class="sample-output__line sample-output__line--long"></div>
              <div class="sample-output__line sample-output__line--med"></div>
              <div class="sample-output__line sample-output__line--short"></div>
              <div class="sample-output__line sample-output__line--long"></div>
              <div class="sample-output__line sample-output__line--med"></div>
            </div>
            <div class="sample-output__slot sample-output__slot--empty">
              <span class="sample-output__slot-label">728×90 · SLOT_EMPTY</span>
            </div>
            <div class="sample-output__body-lines">
              <div class="sample-output__line sample-output__line--long"></div>
              <div class="sample-output__line sample-output__line--short"></div>
            </div>
          </div>
          <div class="sample-output__overlay" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="section section--accent section--diag-both" data-scene-bg="#0c1218" data-scene-accent="#7ee4d2">
    <div class="container">
      <div class="section__head reveal">
        <div class="section__copy">
          <p class="section__eyebrow mono">Platform capabilities</p>
          <h2>Everything you need for repeatable ad slot QA</h2>
          <p class="section__intro">Slot discovery, scheduled runs, and GEO-routed checks — one platform, structured evidence every time.</p>
        </div>
      </div>
      <div class="bento reveal-group">

        <!-- Large card: slot discovery -->
        <article class="bento__item bento__item--lg reveal">
          <div class="bento__eyebrow">Discovery</div>
          <h3 class="bento__title">Slot discovery scan</h3>
          <p class="bento__desc">Automatically detect ad slot selectors on any page before setting up a template. No manual DOM inspection or CSS selector hunting required.</p>
          <div class="bento__mock" aria-hidden="true">
            <div class="bento__mock-row"><span class="bento__mock-dot bento__mock-dot--ok"></span><span class="bento__mock-selector">#div-gpt-ad-leaderboard</span><span class="bento__mock-status bento__mock-status--ok">OK</span></div>
